import logging
import time

import cflib.crtp
from cflib.crazyflie import Crazyflie
from cflib.crazyflie.syncCrazyflie import SyncCrazyflie
from cflib.utils import uri_helper

import usb_config  # This will set up the backend (from chatgpt) 

# URI to the Crazyflie to connect to
uri = uri_helper.uri_from_env(default='radio://0/90/2M/A0A0A0A0AA')
uri_2 = uri_helper.uri_from_env(default='radio://0/80/2M/A0A0A0A0A8')
uri_3 = uri_helper.uri_from_env(default='radio://0/80/2M/A0A0A0A0AC')

def simple_connect():

    print("Yeah, I'm connected! :D")
    time.sleep(3)
    print("Now I will disconnect :'(")

def take_off(scf):
    commander= scf.cf.high_level_commander

    commander.takeoff(1.0, 2.0)
    time.sleep(3)

def land(scf):
    commander= scf.cf.high_level_commander

    commander.land(0.0, 2.0)
    time.sleep(2)

    commander.stop()


if __name__ == '__main__':
    # Initialize the low-level drivers
    cflib.crtp.init_drivers()

    flight_time = 1

    with SyncCrazyflie(uri, cf=Crazyflie(rw_cache='./cache')) as scf_1:
         with SyncCrazyflie(uri_2, cf=Crazyflie(rw_cache='./cache')) as scf_2:
            with SyncCrazyflie(uri_3, cf=Crazyflie(rw_cache='./cache')) as scf_3:

                commander_0 = scf_1.cf.high_level_commander
                commander_1 = scf_2.cf.high_level_commander
                commander_2 = scf_3.cf.high_level_commander

                commander_0.takeoff(1.0, 2.0)
                commander_1.takeoff(1.0, 2.0)
                commander_2.takeoff(1.0, 2.0)

                time.sleep(5)

                commander_0.go_to(0, 0, .5, 0, flight_time, relative=False)
                commander_1.go_to(.25, .25, 1, 0, flight_time, relative=False)
                commander_2.go_to(.5, .5, 1.5, 0, flight_time, relative=False)

                time.sleep(flight_time)

                commander_0.land(0.0, 2.0)
                commander_1.land(0.0, 2.0)
                commander_2.land(0.0, 2.0)

                time.sleep(3)

                commander_0.stop()
                commander_1.stop()
                commander_2.stop()



